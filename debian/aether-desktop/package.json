{
  "name": "aether-desktop",
  "version": "2.4.0",
  "description": "Aether Desktop — AI-агент Aether для Debian",
  "homepage": "https://github.com/jcufyr6d5djj-beep/aether",
  "main": "main.js",
  "author": "Aether Lab",
  "license": "SEE LICENSE IN ../../LICENSE",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage deb",
    "dist:deb": "electron-builder --linux deb",
    "dist:appimage": "electron-builder --linux AppImage",
    "test": "node --test test/smoke.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aether.desktop",
    "productName": "Aether",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "src/**/*",
      "build/**/*",
      "!test/**",
      "!vendor/pi-bridge/node_modules/**",
      "!vendor/pi-bridge/src/**",
      "!vendor/pi-bridge/scripts/**",
      "!vendor/pi-bridge/tests/**"
    ],
    "extraResources": [
      {
        "from": "vendor/pi-bridge",
        "to": "pi-bridge",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      }
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "executableName": "aether-desktop",
      "desktop": {
        "Name": "Aether",
        "Comment": "AI-агент Aether для Debian",
        "Terminal": "false",
        "Categories": "Development;Utility;",
        "StartupWMClass": "Aether"
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libasound2t64 | libasound2",
        "libnotify4",
        "xdg-utils",
        "libxtst6",
        "libxss1",
        "libgbm1",
        "libdrm2",
        "libxcb-dri3-0"
      ],
      "afterInstall": "build/after-install.sh",
      "maintainer": "Aether Lab",
      "synopsis": "AI-агент Aether для Debian",
      "description": "Aether Desktop — настольное приложение с агентом Pi (чат, инструменты, опросы, расширения) для Debian 13."
    }
  }
}
