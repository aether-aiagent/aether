    android:sessionService="com.aether.app.assistant.AetherAssistantSessionService"
    android:recognitionService="com.aether.app.assistant.AetherRecognitionService"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="false"
    android:supportsLocalInteraction="false" />
